# ==========================================
# Application
# ==========================================

APP_ENV=development
APP_PORT=4000

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=bigproject
POSTGRES_USER=bigproject
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bigproject:change_me_local@localhost:5432/bigproject?schema=public

# ==========================================
# Valkey
# ==========================================

VALKEY_PORT=6379
VALKEY_PASSWORD=change_me_local

VALKEY_URL=redis://:change_me_local@localhost:6379

# ==========================================
# S3-compatible storage / SeaweedFS
# ==========================================

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=bigproject
S3_SECRET_KEY=change_me_local_storage
S3_BUCKET=bigproject-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

S3_PORT=8333
SEAWEED_MASTER_PORT=9333
SEAWEED_FILER_PORT=8888
SEAWEED_ADMIN_PORT=23646

# ==========================================
# Authentication
# ==========================================

JWT_ACCESS_SECRET=replace_me_local
JWT_REFRESH_SECRET=replace_me_local

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 32 random bytes encoded as 64 hex characters; required before enabling 2FA.
TOTP_ENCRYPTION_KEY=

# External delivery is opt-in. IN_APP notifications are stored even when delivery is off.
NOTIFICATION_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
FIREBASE_PROJECT_ID=
# Service-account JSON path supplied locally or via platform ADC. Never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=
